# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# PyInstaller build *intermediates* only.
# The built binary itself is published via GitHub Releases, not committed here.
build/
dist/
# Ignore PyInstaller-GENERATED specs, but keep our hand-written build recipe.
*.spec
!packaging/*.spec

# Local runtime state that must never be committed (may contain user data):
*.audit.jsonl
audit-logs/
local_state/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
